generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  ARCHITECT
  END_USER
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum SaleStatus {
  DRAFT
  PUBLISHED
  CLOSED
  DELIVERED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id String @id @default(uuid())

  authUserId String @unique

  email String @unique
  name  String

  avatarUrl String?

  role   UserRole
  status UserStatus @default(PENDING)

  // END_USER → Company
  companyId String?

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Sales created by this user
  sales Sale[]

  // Companies assigned to this architect
  architectCompanies Company[] @relation("CompanyArchitect")

  // Invitations sent by this user
  invitationsSent Invitation[] @relation("InvitationInviter")

  // Invitation associated with this user
  invitation Invitation? @relation("InvitationUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@index([companyId])
}

// ─────────────────────────────────────────────
// COMPANY
// ─────────────────────────────────────────────

model Company {
  id String @id @default(uuid())

  name String

  // ARCHITECT responsible for this company
  architectId String

  architect User? @relation("CompanyArchitect", fields: [architectId], references: [id], onDelete: SetNull)

  // END_USERS belonging to this company
  users User[]

  // Sales belonging to this company
  sales Sale[]

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([architectId])
  @@index([active])
}

// ─────────────────────────────────────────────
// SALE
// ─────────────────────────────────────────────

model Sale {
  id String @id @default(uuid())

  companyId String

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdById String

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  status SaleStatus @default(DRAFT)

  // ─────────────────────────────────────────
  // Sale data
  // ─────────────────────────────────────────

  customerName String?

  amount Decimal? @db.Decimal(12, 2)

  notes String?

  // ─────────────────────────────────────────
  // Lifecycle
  // ─────────────────────────────────────────

  publishedAt DateTime?

  closedAt DateTime?

  deliveredAt DateTime?

  // Soft delete
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([createdById])
  @@index([status])
  @@index([active])
  @@index([companyId, status])
}

// ─────────────────────────────────────────────
// INVITATION
// ─────────────────────────────────────────────

model Invitation {
  id String @id @default(uuid())

  email String

  role UserRole

  status InvitationStatus @default(PENDING)

  // User who sent the invitation
  invitedById String

  invitedBy User @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)

  // User created from this invitation
  userId String? @unique

  user User? @relation("InvitationUser", fields: [userId], references: [id], onDelete: SetNull)

  expiresAt DateTime

  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([invitedById])
}
